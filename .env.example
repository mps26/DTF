# ========================================================
# DTF Set Files - Cloud SQLite Database Configuration
# ========================================================
# To sync user accounts between Localhost and Vercel in SQLite:
# 1. Create a free database at https://turso.tech (or run `npx turso-cli db create dtf-users`)
# 2. Add these 2 variables to your local .env file and in your Vercel Project Settings -> Environment Variables.

TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
